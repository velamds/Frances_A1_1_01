{"_data": [{"type": "metadata", "contents": [{"content": "Commencer", "type": "lesson_name"}, {"content": "Je m'appelle N-A-T-H-A-L-I-E", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant \u00e9change de l'information personnelle sur le lieu de r\u00e9sidence et sur la famille, dans des situations communicatives. ", "type": "primary"}, {"content": "L'apprenant comprend de l'information simple dans des conversations \u00e0 un d\u00e9bit lent, qui concernent des sujets communicatifs et le vocabulaire de ce niveau. ", "type": "secondary_1"}, {"content": "L'apprenant comprend de l'information simple dans des conversations \u00e0 un d\u00e9bit lent, qui concernent des sujets communicatifs et le vocabulaire de ce niveau. ", "type": "secondary_2"}, {"content": "L'apprenant comprend de l'information simple dans des conversations \u00e0 un d\u00e9bit lent, qui concernent des sujets communicatifs et le vocabulaire de ce niveau. ", "type": "secondary_3"}, {"content": "L'apprenant comprend de l'information simple dans des conversations \u00e0 un d\u00e9bit lent, qui concernent des sujets communicatifs et le vocabulaire de ce niveau. ", "type": "secondary_4"}, {"content": "L'apprenant comprend de l'information simple dans des conversations \u00e0 un d\u00e9bit lent, qui concernent des sujets communicatifs et le vocabulaire de ce niveau. ", "type": "secondary_5"}, {"content": "L'apprenant comprend de l'information simple dans des conversations \u00e0 un d\u00e9bit lent, qui concernent des sujets communicatifs et le vocabulaire de ce niveau. ", "type": "secondary_6"}, {"content": "L'apprenant comprend de l'information simple dans des conversations \u00e0 un d\u00e9bit lent, qui concernent des sujets communicatifs et le voc